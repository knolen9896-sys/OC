<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Web Desktop Environment</title>
<style>
  body {
    margin: 0;
    background-color: #008080; /* Desktop background color */
    font-family: Arial, sans-serif;
    overflow: hidden;
  }

  /* Desktop icons */
  #desktop {
    display: flex;
    flex-wrap: wrap;
    padding: 20px;
  }

  .icon {
    width: 80px;
    margin: 10px;
    cursor: pointer;
    text-align: center;
    color: white;
  }

  .icon img {
    width: 50px;
    height: 50px;
  }

  /* App windows */
  .window {
    position: absolute;
    width: 300px;
    height: 200px;
    background-color: white;
    border: 1px solid #ccc;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.3);
    display: flex;
    flex-direction: column;
    z-index: 10;
    cursor: move;
  }

  .titleBar {
    background-color: #007ACC;
    color: white;
    padding: 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: move;
  }

  .content {
    flex: 1;
    padding: 10px;
  }

  .closeBtn {
    background: none;
    border: none;
    color: white;
    font-weight: bold;
    cursor: pointer;
  }
</style>
</head>
<body>

<!-- Desktop icons -->
<div id="desktop">
  <div class="icon" onclick="openWindow('Browser')">
    <img src="https://img.icons8.com/ios/50/ffffff/internet-browser.png" alt="Browser" />
    <div>Browser</div>
  </div>
  <div class="icon" onclick="openWindow('Notes')">
    <img src="https://img.icons8.com/ios/50/ffffff/notepad.png" alt="Notes" />
    <div>Notes</div>
  </div>
</div>

<!-- Container for open windows -->
<div id="windowsContainer"></div>

<script>
let windowCount = 0;

function openWindow(title) {
  windowCount++;
  const windowId = 'win' + windowCount;
  const container = document.getElementById('windowsContainer');
  
  const win = document.createElement('div');
  win.className = 'window';
  win.id = windowId;
  win.style.top = (50 + Math.random() * 300) + 'px';
  win.style.left = (50 + Math.random() * 400) + 'px';

  // Title bar
  const titleBar = document.createElement('div');
  titleBar.className = 'titleBar';
  titleBar.innerHTML = `
    <span>${title}</span>
    <button class="closeBtn" onclick="closeWindow('${windowId}')">X</button>
  `;

  // Make window draggable
  makeDraggable(win, titleBar);

  // Content area
  const content = document.createElement('div');
  content.className = 'content';
  content.innerHTML = `<p>This is the ${title} window.</p>`;

  win.appendChild(titleBar);
  win.appendChild(content);
  container.appendChild(win);
}

function closeWindow(id) {
  const win = document.getElementById(id);
  if (win) {
    win.remove();
  }
}

// Drag functionality
function makeDraggable(element, handle) {
  let offsetX = 0, offsetY = 0, isDown = false;

  handle.onmousedown = function(e) {
    isDown = true;
    offsetX = element.offsetLeft - e.clientX;
    offsetY = element.offsetTop - e.clientY;
  };

  document.onmouseup = function() {
    isDown = false;
  };

  document.onmousemove = function(e) {
    if (isDown) {
      element.style.left = e.clientX + offsetX + 'px';
      element.style.top = e.clientY + offsetY + 'px';
    }
  };
}
</script>

</body>
</html>
